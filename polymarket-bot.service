[Unit]
Description=Polymarket Market Maker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/polymarket-worldcup-volume-bot
ExecStart=/home/ubuntu/polymarket-worldcup-volume-bot/venv/bin/python bot.py
Restart=on-failure
RestartSec=15
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/home/ubuntu/polymarket-worldcup-volume-bot/.env
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
